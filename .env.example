# Lokal: file:data/monitor.db. Für den Zeitplan auf GitHub wird sie über den Cache gehalten
# und bei Bedarf aus public/bootstrap.json wieder aufgebaut.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Nur für den lokalen Serverbetrieb (npm run dev). Zufällige, unterschiedliche Schlüssel;
# niemals NEXT_PUBLIC verwenden. Die veröffentlichte Seite braucht sie nicht.
APP_TOKEN=
CRON_SECRET=
# Nur auf true setzen, wenn ein echter Scheduler eingerichtet ist.
SCHEDULE_ENABLED=false
# Pflicht: ohne Schlüssel bleiben beide DIP-Quellen auf "Schlüssel fehlt".
# Öffentlicher Schlüssel und Bezugsweg: https://dip.bundestag.de/über-dip/hilfe/api
DIP_API_KEY=
# Optional: andere Wahlperiode abfragen (Standard 21).
DIP_WAHLPERIODE=21
# Optional: Aufbewahrung in Tagen (Standard 180); 0 schaltet sie ab.
RETENTION_DAYS=180
# Optional: abweichende amtliche BAFA-Feed-URL.
BAFA_FEED_URL=
