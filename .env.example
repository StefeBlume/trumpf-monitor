# Lokal: file:data/monitor.db; Hosting: libsql://... (persistente Datenbank, z. B. Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Zufällige, unterschiedliche Schlüssel; niemals NEXT_PUBLIC verwenden.
APP_TOKEN=
CRON_SECRET=
# Nur nach Einrichtung eines echten Schedulers true setzen.
SCHEDULE_ENABLED=false
# Pflicht: ohne Schlüssel bleiben beide DIP-Quellen auf "Schlüssel fehlt".
# Öffentlicher Schlüssel und Bezugsweg: https://dip.bundestag.de/über-dip/hilfe/api
DIP_API_KEY=
# Optional: andere Wahlperiode abfragen (Standard 21).
DIP_WAHLPERIODE=21
# Optional: abweichende amtliche BAFA-Feed-URL.
BAFA_FEED_URL=
# Nur für die private iPhone-Installation; lokaler Mac oder eigener HTTPS-Server
MOBILE_SERVER_URL=http://192.168.178.126:4180
